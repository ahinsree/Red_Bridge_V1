# Copy to .env.local for local development. Set the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Contact form → Zoho CRM Leads (used by /api/contact). Self Client credentials from api-console.zoho.in;
# see docs/deployment-vercel.md → "Zoho CRM setup" for generating the refresh token.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Optional. Defaults are the India data center.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_URL=https://www.zohoapis.in
# Optional. Must exactly match an existing "Lead Source" picklist value in Zoho (e.g. Web Research); leave blank to skip.
ZOHO_LEAD_SOURCE=

# Decap CMS GitHub OAuth app (used by /api/auth and /api/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
