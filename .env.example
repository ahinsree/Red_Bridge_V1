# Copy to .env.local for local development. Set the same keys in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Contact form: Google Apps Script web app URL that appends rows to the leads sheet (used by /api/contact)
GOOGLE_SCRIPT_URL=

# Decap CMS GitHub OAuth app (used by /api/auth and /api/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
